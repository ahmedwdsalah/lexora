{
  "expo": {
    "name": "lexora",
    "slug": "lexora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lexora",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Lexora photographs your handwritten notes to turn them into vocabulary."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lexora lets you pick photos of your notes from your library."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Lexora records your voice to score your pronunciation."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lexora adapts your lessons to where you live."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ahmedsalah998.lexora",
      "infoPlist": {
        "NSCameraUsageDescription": "Lexora photographs your handwritten notes to turn them into vocabulary.",
        "NSMicrophoneUsageDescription": "Lexora records your voice to score your pronunciation.",
        "NSPhotoLibraryUsageDescription": "Lexora lets you pick photos of your notes from your library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b1fbffd-c5a9-44ff-88de-9d58f3ea751b"
      }
    }
  }
}
